{
  "info": {
    "name": "PG Go API",
    "description": "pg-go REST API — CONTRACT Rev 7 is canonical (CONTRACT.md).\n\nFolders: Public, Join, Owner, Tenant, Search, Notifications, Manager, Gamification, Legacy OTP.\n\nImport with pg-go.postman_environment.json. Run Public → Firebase Exchange first; token auto-saves. Set property_id for facility/manager queries.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "api_base_url", "value": "http://localhost:8080/api" },
    { "key": "origin_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "phone", "value": "+919876543210" },
    { "key": "id_token", "value": "" },
    { "key": "invite_code", "value": "DEVINV01" },
    { "key": "join_id", "value": "" },
    { "key": "report_id", "value": "" },
    { "key": "tenant_id", "value": "" },
    { "key": "due_id", "value": "" },
    { "key": "payment_token", "value": "" },
    { "key": "property_id", "value": "" },
    { "key": "notification_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{origin_url}}/healthz"
          }
        },
        {
          "name": "API Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{api_base_url}}/healthz"
          }
        },
        {
          "name": "VAPID Public Key",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{api_base_url}}/push/vapid-public-key"
          }
        },
        {
          "name": "Firebase Exchange",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "if (json.user && json.user.role) pm.collectionVariables.set('role', json.user.role);",
                  "if (json.user && json.user.tenant_id) pm.collectionVariables.set('tenant_id', json.user.tenant_id);",
                  "if (json.user && json.user.property_id) pm.collectionVariables.set('property_id', json.user.property_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{id_token}}\",\n  \"invite_code\": \"{{invite_code}}\"\n}"
            },
            "url": "{{api_base_url}}/auth/firebase"
          }
        },
        {
          "name": "Revoke Sessions",
          "request": {
            "method": "POST",
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{api_base_url}}/auth/revoke-sessions"
          }
        },
        {
          "name": "Payment Page (HTML)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{origin_url}}/p/{{payment_token}}"
          }
        }
      ]
    },
    {
      "name": "Join",
      "item": [
        {
          "name": "Lookup Invite",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{api_base_url}}/join/invite/{{invite_code}}"
          }
        },
        {
          "name": "Join Me",
          "request": { "method": "GET", "url": "{{api_base_url}}/join/me" }
        },
        {
          "name": "Join Profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul\",\n  \"consent\": true,\n  \"uid_last4\": \"1234\",\n  \"confirm\": true\n}"
            },
            "url": "{{api_base_url}}/join"
          }
        }
      ]
    },
    {
      "name": "Owner",
      "item": [
        {
          "name": "List Properties",
          "request": { "method": "GET", "url": "{{api_base_url}}/owner/properties" }
        },
        {
          "name": "Owner Invite",
          "request": { "method": "GET", "url": "{{api_base_url}}/owner/invite" }
        },
        {
          "name": "Rotate Invite",
          "request": {
            "method": "POST",
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{api_base_url}}/owner/invite/rotate"
          }
        },
        {
          "name": "List Join Requests",
          "request": { "method": "GET", "url": "{{api_base_url}}/owner/join-requests?status=pending" }
        },
        {
          "name": "Activate Join",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_number\": \"101\",\n  \"rent_amount\": 1500000,\n  \"due_day\": 5,\n  \"deposit_amount\": 1500000\n}"
            },
            "url": "{{api_base_url}}/owner/join-requests/{{join_id}}/activate"
          }
        },
        {
          "name": "Reject Join",
          "request": {
            "method": "POST",
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{api_base_url}}/owner/join-requests/{{join_id}}/reject"
          }
        },
        {
          "name": "List Payment Reports",
          "request": { "method": "GET", "url": "{{api_base_url}}/owner/payment-reports?status=pending_review" }
        },
        {
          "name": "Confirm Payment Report",
          "request": {
            "method": "POST",
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{api_base_url}}/owner/payment-reports/{{report_id}}/confirm"
          }
        },
        {
          "name": "Reject Payment Report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"UTR mismatch\"\n}" },
            "url": "{{api_base_url}}/owner/payment-reports/{{report_id}}/reject"
          }
        },
        {
          "name": "List Tenants",
          "request": { "method": "GET", "url": "{{api_base_url}}/owner/tenants" }
        },
        {
          "name": "Create Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('tenant_id', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"phone\": \"+919876543210\",\n  \"room_number\": \"101\",\n  \"rent_amount\": 1500000,\n  \"due_day\": 5,\n  \"notice_period_days\": 30\n}"
            },
            "url": "{{api_base_url}}/owner/tenants"
          }
        },
        {
          "name": "Update Tenant",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_number\": \"102\"\n}"
            },
            "url": "{{api_base_url}}/owner/tenants/{{tenant_id}}"
          }
        },
        {
          "name": "Tenant Notice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{api_base_url}}/owner/tenants/{{tenant_id}}/notice"
          }
        },
        {
          "name": "Tenant Vacate",
          "request": {
            "method": "POST",
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{api_base_url}}/owner/tenants/{{tenant_id}}/vacate"
          }
        },
        {
          "name": "Attach Phone",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": "{{api_base_url}}/owner/tenants/{{tenant_id}}/attach-phone"
          }
        },
        {
          "name": "List Dues",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.dues && json.dues.length) pm.collectionVariables.set('due_id', json.dues[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api_base_url}}/owner/dues?status=pending",
              "host": ["{{api_base_url}}"],
              "path": ["owner", "dues"],
              "query": [{ "key": "status", "value": "pending" }]
            }
          }
        },
        {
          "name": "Waive Due",
          "request": {
            "method": "POST",
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{api_base_url}}/owner/dues/{{due_id}}/waive"
          }
        },
        {
          "name": "Mark Cash Paid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1500000,\n  \"note\": \"Collected in cash\"\n}"
            },
            "url": "{{api_base_url}}/owner/dues/{{due_id}}/mark-cash-paid"
          }
        },
        {
          "name": "Manual Match",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1500000,\n  \"upi_txn_id\": \"UPI123456789\"\n}"
            },
            "url": "{{api_base_url}}/owner/dues/{{due_id}}/match"
          }
        },
        {
          "name": "Due Pay JSON",
          "request": { "method": "GET", "url": "{{api_base_url}}/owner/dues/{{due_id}}/pay" }
        },
        {
          "name": "Due QR (PNG)",
          "request": { "method": "GET", "url": "{{api_base_url}}/owner/dues/{{due_id}}/qr" }
        },
        {
          "name": "Create Payment Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.path) {",
                  "  const token = json.path.replace('/p/', '');",
                  "  pm.collectionVariables.set('payment_token', token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{api_base_url}}/owner/dues/{{due_id}}/token"
          }
        },
        {
          "name": "List Payments",
          "request": { "method": "GET", "url": "{{api_base_url}}/owner/payments" }
        },
        {
          "name": "Import Statements (CSV)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            },
            "url": "{{api_base_url}}/owner/statements/import"
          }
        },
        {
          "name": "Reconciliation Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api_base_url}}/owner/reconciliation?period=2026-08",
              "host": ["{{api_base_url}}"],
              "path": ["owner", "reconciliation"],
              "query": [{ "key": "period", "value": "2026-08" }]
            }
          }
        },
        {
          "name": "List Events",
          "request": { "method": "GET", "url": "{{api_base_url}}/owner/events" }
        }
      ]
    },
    {
      "name": "Tenant",
      "item": [
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{api_base_url}}/tenant/me" }
        },
        {
          "name": "My Dues",
          "request": { "method": "GET", "url": "{{api_base_url}}/tenant/dues" }
        },
        {
          "name": "Due Pay JSON",
          "request": { "method": "GET", "url": "{{api_base_url}}/tenant/dues/{{due_id}}/pay" }
        },
        {
          "name": "Due QR (PNG)",
          "request": { "method": "GET", "url": "{{api_base_url}}/tenant/dues/{{due_id}}/qr" }
        },
        {
          "name": "My Payments",
          "request": { "method": "GET", "url": "{{api_base_url}}/tenant/payments" }
        },
        {
          "name": "Push Subscribe",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"https://example.com/push\",\n  \"keys\": {\n    \"p256dh\": \"test\",\n    \"auth\": \"test\"\n  }\n}"
            },
            "url": "{{api_base_url}}/tenant/push/subscribe"
          }
        },
        {
          "name": "Aadhaar KYC",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consent\": true,\n  \"channel\": \"tenant_app\",\n  \"uid_last4\": \"1234\"\n}"
            },
            "url": "{{api_base_url}}/tenant/aadhaar"
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Global Search",
          "request": {
            "method": "GET",
            "url": "{{api_base_url}}/search?q=ravi&limit=20"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.notifications && json.notifications.length) pm.collectionVariables.set('notification_id', json.notifications[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{api_base_url}}/notifications?limit=20"
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "url": "{{api_base_url}}/notifications/{{notification_id}}/read"
          }
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "PATCH",
            "url": "{{api_base_url}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Manager",
      "item": [
        {
          "name": "List Inspections",
          "request": {
            "method": "GET",
            "url": "{{api_base_url}}/manager/inspections?property_id={{property_id}}"
          }
        },
        {
          "name": "Kitchen Headcount",
          "request": {
            "method": "GET",
            "url": "{{api_base_url}}/manager/kitchen/headcount?property_id={{property_id}}"
          }
        }
      ]
    },
    {
      "name": "Gamification",
      "item": [
        {
          "name": "Tenant Points",
          "request": {
            "method": "GET",
            "url": "{{api_base_url}}/tenant/points"
          }
        },
        {
          "name": "Owner List Floors",
          "request": {
            "method": "GET",
            "url": "{{api_base_url}}/owner/floors?property_id={{property_id}}"
          }
        }
      ]
    },
    {
      "name": "Legacy OTP (deprecated)",
      "description": "Rollback / not primary login. Prefer Firebase Exchange.",
      "item": [
        {
          "name": "OTP Request",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": "{{api_base_url}}/auth/otp/request"
          }
        },
        {
          "name": "OTP Verify",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"000000\"\n}"
            },
            "url": "{{api_base_url}}/auth/otp/verify"
          }
        }
      ]
    }
  ]
}
