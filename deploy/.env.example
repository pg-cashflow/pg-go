# /opt/pg-app/.env — Production Environment Configuration for pg-app
# Must be placed at /opt/pg-app/.env on the host server before starting pg-app.service.
# Permissions should be locked down:
#   sudo chown pgapp:pgapp /opt/pg-app/.env
#   sudo chmod 600 /opt/pg-app/.env

# Database (Neon PostgreSQL connection string with SSL enabled)
DATABASE_URL=postgres://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/pg_cashflow?sslmode=require

# Auth Secrets (Generate long random strings: openssl rand -base64 32)
JWT_SECRET=generate-a-32-byte-secret-for-jwt-signing-tokens
OTP_HMAC_SECRET=generate-a-32-byte-secret-for-otp-hmac
MAGIC_LINK_HMAC_SECRET=generate-a-32-byte-secret-for-magic-link-hmac
# Magic link public URL displayed in SMS/WhatsApp (e.g. https://pg.yourdomain.com)
MAGIC_LINK_BASE_URL=https://pg.yourdomain.com

# Server Binding
HTTP_ADDR=:8080
APP_ENV=production

# CORS (In prod, the single binary serves frontend at origin; leave localhost for dev or keep empty)
CORS_ALLOWED_ORIGINS=

# Web Push (VAPID keys for browser push notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Firebase Service Account (JSON key downloaded from Firebase Console)
# Provisioning steps on host:
#   1. Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
#   2. Copy the JSON file to /opt/pg-app/secrets/firebase-sa.json
#   3. Restrict permissions so pgapp can read it:
#        sudo chown pgapp:pgapp /opt/pg-app/secrets/firebase-sa.json
#        sudo chmod 600 /opt/pg-app/secrets/firebase-sa.json
FIREBASE_PROJECT_ID=pg-cashflow-prod
GOOGLE_APPLICATION_CREDENTIALS=/opt/pg-app/secrets/firebase-sa.json

# Android SMS Gateway (Optional: physical Android phone gateway on local LAN)
SMS_PRIMARY_URL=
SMS_PRIMARY_API_KEY=
SMS_FALLBACK_URL=
SMS_FALLBACK_API_KEY=

# SMTP / Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Cashfree Payment Gateway (Set when payment_mode=cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
CASHFREE_WEBHOOK_SECRET=

# UIDAI Secure QR (PEM format string if verifying Aadhaar QR offline)
AADHAAR_QR_PUBLIC_KEY_PEM=
