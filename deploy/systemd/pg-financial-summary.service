[Unit]
Description=pg-app financial summary job (generate daily owner digest)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pgapp
Group=pgapp
WorkingDirectory=/opt/pg-app
EnvironmentFile=/opt/pg-app/.env
ExecStart=/opt/pg-app/financial-summary

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pg-app
PrivateTmp=true
