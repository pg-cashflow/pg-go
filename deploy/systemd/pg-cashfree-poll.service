[Unit]
Description=pg-app cashfree poll job (fallback poll for unconfirmed payment intents)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pgapp
Group=pgapp
WorkingDirectory=/opt/pg-app
EnvironmentFile=/opt/pg-app/.env
ExecStart=/opt/pg-app/cashfree-poll

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pg-app
PrivateTmp=true
