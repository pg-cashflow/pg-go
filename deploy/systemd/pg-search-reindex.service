[Unit]
Description=pg-app search reindex job (weekly trigram and lexical index sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pgapp
Group=pgapp
WorkingDirectory=/opt/pg-app
EnvironmentFile=/opt/pg-app/.env
ExecStart=/opt/pg-app/search-reindex

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pg-app
PrivateTmp=true
