[Unit]
Description=pg-app gamification cycle job (monthly tier evaluations & streak resets)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pgapp
Group=pgapp
WorkingDirectory=/opt/pg-app
EnvironmentFile=/opt/pg-app/.env
ExecStart=/opt/pg-app/gamification-cycle

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pg-app
PrivateTmp=true
