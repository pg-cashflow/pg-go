# Database (Neon)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string
OTP_HMAC_SECRET=change-me-otp-hmac-secret
MAGIC_LINK_HMAC_SECRET=change-me-magic-link-hmac
MAGIC_LINK_BASE_URL=https://pay.example.com

# Android SMS Gateway — Device A (primary)
SMS_PRIMARY_URL=http://device-a.local:8080/send
SMS_PRIMARY_API_KEY=

# Android SMS Gateway — Device B (fallback, different SIM)
SMS_FALLBACK_URL=http://device-b.local:8080/send
SMS_FALLBACK_API_KEY=

# SMTP (Gmail App Password; Brevo is drop-in via same vars)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Server
HTTP_ADDR=:8080
APP_ENV=development
# AUTO_MIGRATE=1 runs migrations/*.sql on server boot (dev convenience; prefer cmd/migrate in prod).

# Global search (lexical + optional hybrid embeddings)
# SEARCH_EMBEDDING=hash enables local deterministic vectors for hybrid mode (dev only).
# SEARCH_EMBEDDING=none
# SEARCH_REINDEX_ON_START=1 rebuilds search_documents on server boot (requires SEARCH_EMBEDDING=hash or real embedder).

# Frontend (pg-react PWA)
# Local development (cross-origin):
#   In pg-react/.env.local set: VITE_API_BASE_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: single binary serves both API and embedded PWA on the same host behind Cloudflare Tunnel.
# In production, pg-react is built with VITE_API_BASE_URL=/api and FRONTEND_URL is unused.

# Firebase Admin — verify ID tokens from pg-react at POST /auth/firebase
# Console: Project settings → Service accounts → Generate new private key
# Save the JSON as ./secrets/firebase-sa.json (gitignored).
FIREBASE_PROJECT_ID=pg-cashflow-prod
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-sa.json
# Dev/test: Auth → Sign-in method → Phone → Phone numbers for testing (Spark is enough).
# Production (only after test-number login works end-to-end):
#   1. Upgrade pg-cashflow-prod to Blaze
#   2. Auth → Settings → Authorized domains: production host only (no https://, no port)
#   3. Phone provider: allow India SMS region
#   4. Set billing alerts on the linked Google Cloud billing account
#   5. Keep test numbers for local/dev; try one real +91 last

# Cashfree Payment Gateway & SecureID KYC
# Owner absorbs TDR — do not add a convenience fee / surcharge.
# Do not flip payment_mode to cashfree until live KYC is done; sandbox is enough to wire webhooks.
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET_KEY=
CASHFREE_KYC_APP_ID=
CASHFREE_KYC_SECRET_KEY=
CASHFREE_ENV=sandbox
# Defaults to CASHFREE_PG_SECRET_KEY when empty. Required in production if Cashfree PG keys are set.
CASHFREE_WEBHOOK_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300
ORDER_EXPIRY_DURATION=30m
ORDER_POLLER_BUFFER_DURATION=2h
CASHFREE_API_VERSION=2025-01-01

# Cashfree Payouts (Transfers V2 — Track L)
# Distinct credentials from Payment Gateway. Required for automated operational payouts.
CF_PAYOUT_CLIENT_ID=
CF_PAYOUT_CLIENT_SECRET=
CF_PAYOUT_API_VERSION=2024-01-01
CF_PAYOUT_FUNDSOURCE_ID=
CF_PAYOUT_WEBHOOK_SECRET=
CF_PAYOUT_ENV=sandbox

# Aadhaar KYC (ADR-004)
# KYC_IDENTITY_SECRET: HMAC-SHA256 key used to compute tenant identity_hash.
# MUST be unique and separate from JWT_SECRET to preserve versioned rotation runbooks.
KYC_IDENTITY_SECRET=change-me-kyc-identity-hmac-secret-min-32-chars
# Optional: defaults to FRONTEND_URL + "/tenant/kyc/callback"
KYC_DIGILOCKER_REDIRECT_URL=

# UIDAI Secure QR public key (PEM). Required to verify Aadhaar card QR payloads.
# Leave empty to fail-closed on numeric Secure QR (manual last-4 still works).
AADHAAR_QR_PUBLIC_KEY_PEM=
